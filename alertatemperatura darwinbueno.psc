Algoritmo alertatemperatura
	definir temp como Real;
	escribir " ingrese la temperatura actual en grado celsius(°C):"; 
	leer temp;
	
	si temp < 0 Entonces
		escribir "ADVEERTENCIA:temperatura bajo cero detectado.";
		escribir " Riesgo de congelamiento en carreteras. ", "conduzca con preacucion.";
		
	
	FinSi
	
	escribir " riesgo meterologico completrado.";  
	
FinAlgoritmo
