Algoritmo validaraprobaciom
	definir nota como real;
	
	escribir " ingrese la calificacion final obtenidad (0.0 - 10.0):";
	leer nota; 
	
	si nota >= 3.0 Entonces
		escribir "¡ Enhorabuena! ha aprobado satisfacioramente la asignatura.";
		
	FinSi
	
	escribir " proceso de reporte de calificacion finalizada."; 
	
	si nota < 3 Entonces
		
	FinSi
	
	escribir " lo sentimos ha reprobado."; 
	
	
	
FinAlgoritmo
